      "id": "rag-query",
      "name": "RAG Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract RAG context and enhance music prompt\nconst ragResponse = $input.first().json;\nconst originalPrompt = $('Webhook Trigger').first().json.body.prompt;\nconst musicStyle = $('Webhook Trigger').first().json.body.style || '';\n\n// Combine RAG context with original prompt\nconst contextInfo = ragResponse.sources\n  .map(s => s.content)\n  .join(' ');\n\nconst enhancedPrompt = `${originalPrompt}\\n\\nContext: ${contextInfo}`;\n\nreturn {\n  json: {\n    gpt_description_prompt: enhancedPrompt,\n    style: musicStyle,\n    custom_mode: false,\n    make_instrumental: $('Webhook Trigger').first().json.body.instrumental || false,\n    mv: 'chirp-v4',\n    voice_gender: $('Webhook Trigger').first().json.body.voice_gender || 'female'\n  }\n};"
      },
      "id": "enhance-prompt",
      "name": "Enhance Prompt with RAG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "=http://api-gateway:8000/api/v1/music/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
