      },
      "id": "webhook-graphrag",
      "name": "Webhook - GraphRAG Query",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 400],
      "webhookId": "graphrag-query"
    },
    {
      "parameters": {
        "jsCode": "// Step 1: Query Analysis and Decomposition\nconst query = $json.body.query;\nconst strategy = $json.body.strategy || 'hybrid';\nconst useGraphRAG = $json.body.use_graph_rag || true;\n\nreturn {\n  json: {\n    original_query: query,\n    strategy: strategy,\n    use_graph_rag: useGraphRAG,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "analyze-query",
      "name": "Query Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "url": "=http://api-gateway:8000/api/v1/rag/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
