# ====================================
# AI Music API Configuration
# ====================================
AIMUSIC_API_KEY=your_api_key_here
AIMUSIC_BASE_URL=https://api.aimusicapi.ai/v1
POLL_INTERVAL=5
MAX_RETRIES=60
OUTPUT_DIR=./output
AUTO_DOWNLOAD=true
LOG_LEVEL=INFO

# ====================================
# OpenAI Configuration (for R2R)
# ====================================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ====================================
# PostgreSQL Database
# ====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=r2r
N8N_DB=n8n

# ====================================
# R2R Configuration
# ====================================
R2R_CONFIG_NAME=default
R2R_PROJECT_NAME=producer-ai

# ====================================
# n8n Configuration
# ====================================
N8N_USER=admin
N8N_PASSWORD=change_me_secure_password
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678
TIMEZONE=UTC

# ====================================
# Auth0 Configuration
# ====================================
AUTH0_ENABLED=false
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://your-api-identifier

# ====================================
# Supabase Configuration
# ====================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
